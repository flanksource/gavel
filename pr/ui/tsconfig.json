{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@flanksource/clicky-ui": ["./node_modules/@flanksource/clicky-ui/dist/index.d.ts"],
      "@flanksource/clicky-ui/*": ["./node_modules/@flanksource/clicky-ui/dist/*"],
      "@flanksource/gavel/testrunner/hooks": ["../../testrunner/ui/src/hooks.ts"],
      "@flanksource/gavel/testrunner": ["../../testrunner/ui/src/testrunner.ts"]
    }
  },
  "include": ["src"]
}
