{
  "name": "@flanksource/gavel",
  "version": "0.1.2",
  "description": "React hooks, adapters and types for consuming gavel's testrunner real-time test progress UI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flanksource/gavel.git",
    "directory": "testrunner/ui"
  },
  "type": "module",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "sideEffects": false,
  "files": [
    "dist/lib",
    "README.md"
  ],
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    },
    "./testrunner": {
      "types": "./dist/lib/testrunner.d.ts",
      "import": "./dist/lib/testrunner.js",
      "require": "./dist/lib/testrunner.cjs"
    },
    "./testrunner/hooks": {
      "types": "./dist/lib/hooks.d.ts",
      "import": "./dist/lib/hooks.js",
      "require": "./dist/lib/hooks.cjs"
    },
    "./testrunner/types": {
      "types": "./dist/lib/types.d.ts",
      "import": "./dist/lib/types.js",
      "require": "./dist/lib/types.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "build:lib": "vite build -c vite.lib.config.ts && vite build -c vite.lib.config.ts --mode cjs",
    "dev": "vite",
    "test": "vitest run",
    "check": "tsc -p tsconfig.lib.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.8"
  },
  "peerDependencies": {
    "@flanksource/clicky-ui": "catalog:",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@flanksource/clicky-ui": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^25.0.1",
    "monaco-editor": "catalog:",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "catalog:",
    "typescript": "^5.3.0",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
