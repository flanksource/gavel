# yaml-language-server: $schema=https://raw.githubusercontent.com/flanksource/gavel/main/gavel.schema.json
# Example `.gavel.yaml` for Gavel.
# See SCHEMA.md and gavel.schema.json for the full field reference.
#
# You can place `.gavel.yaml` in any of these locations:
#   1. ~/.gavel.yaml
#   2. <git-root>/.gavel.yaml
#   3. <target-dir>/.gavel.yaml
#
# Merge order is exactly the list above, with later layers overriding earlier ones.
# Use `gavel config [path]` to inspect the merged result for a specific file or directory.
# Use `gavel config --resolve [path]` to expand prompt files/inline specs and show
# the effective AI model/backend for every registered prompt.
#
# Merge behavior summary:
#   - Field-wise specs:
#       ai supplies defaults; each operation spec replaces the same operation
#       from an earlier layer, then inherits unset fields from ai and its built-in prompt
#   - Last-write-wins scalars:
#       commit.precommit.mode, todos.timeout,
#       pr.base, ssh.cmd, procfile.profile/autoRestart/maxRestarts/mem/cpu
#   - Appended lists:
#       lint.ignore, commit.hooks, commit.gitignore, commit.allow, pre, post,
#       secrets.configs
#   - Keyed-map overrides:
#       lint.linters.<name>.enabled and procfile.env merge by key
#   - Sticky booleans:
#       fixtures.enabled, secrets.disabled, and pr.draft stay true once enabled
#   - Replacement values:
#       fixtures.files and checks.test/checks.lint replace their parent values

ai:
  # Base model settings inherited by every registered AI operation below.
  # A compact model can include a mechanism and effort: cli:model-name:high.
  model: claude-haiku-4-5
  fallbacks:
    - agent:codex-mini-latest:medium
  effort: medium
  prompt:
    system: Follow repository instructions and report verification evidence.
  budget:
    cost: 2
    maxTokens: 8192
    maxTurns: 20

lint:
  # Source repair uses an editing-capable agent independently of the compact
  # commit.message model below. `gavel lint --model` overrides this per run.
  fix:
    model: agent:sonnet
    effort: high
    budget:
      cost: 2
      maxTurns: 20

  # Ignore rules are appended across layers.
  # Each rule may match by source, rule ID, file glob, or any combination.
  ignore:
    - source: golangci-lint
      rule: errcheck
      file: "internal/generated/**"

    - source: eslint
      file: "web/vendor/**"

  linters:
    # Linter enablement is keyed by name and overrides per linter.
    # This is useful for opt-in linters like jscpd or selectively disabling one tool.
    jscpd:
      enabled: true

    vale:
      enabled: false

commit:
  # Each AI operation accepts a bare prompt string, an object like these, or a
  # `file` path relative to this .gavel.yaml. Unset model fields inherit from ai.
  message:
    # Commit messages only summarize a diff, so this can use a smaller model.
    model: claude-haiku-4-5
    prompt:
      system: Write precise Conventional Commit messages.
      user: |
        Describe the intent of this patch, not its file inventory:
        {{patch}}

  grouping:
    model: codex-mini-latest
    effort: high
    budget:
      maxTokens: 4096
    prompt:
      user: |
        Group these changes into at most {{maxCommits}} cohesive commits:
        {{table}}

  summary:
    prompt:
      user: Summarize {{window}} changes in {{scope}} from {{commits}} and {{files}}.
    # A prompt can instead be loaded relative to this config:
    # file: .gavel/prompts/commit-summary.prompt

  # Cap the number of commits produced by AI grouping. Zero uses the default.
  maxCommits: 4

  # Hooks run during `gavel commit` before the final commit is written.
  # Hooks are appended across layers in declaration order.
  hooks:
    - name: gofmt
      run: gofmt -w ./...
      files:
        - "**/*.go"

    - name: unit
      run: gavel test --changed
      files:
        - "**/*.go"
        - "**/*.ts"

  # Extra ignore globs applied by `gavel commit` when selecting files to commit.
  # These are appended and deduped across layers.
  gitignore:
    - ".claude/"
    - ".cache/"
    - "dist/"

  # Paths that are allowed through even when broader commit.gitignore globs match.
  # This is useful for generated artifacts you intentionally commit.
  allow:
    - "dist/schema.json"
    - "docs/generated/**"

  precommit:
    # Controls both commit.gitignore prompts and local-path dependency handling
    # for package.json file:/link: refs and go.mod replace directives that
    # point outside the repo.
    # Values:
    #   prompt  ask before committing (default)
    #   fail    hard-fail the commit
    #   skip    bypass both precommit checks
    #   false   alias for skip
    mode: prompt

  lint:
    # Run non-secrets linters over staged files; secrets defaults to true.
    enabled: true
    secrets: true

  tidy:
    # Run `go mod tidy` in every Go module and stage go.mod/go.sum changes.
    enabled: true

fixtures:
  # When true, `gavel test` auto-discovers fixture files.
  enabled: true

  # Files replaces the parent layer instead of appending.
  # If omitted, Gavel falls back to the built-in default: **/*.fixture.md
  files:
    - "tests/**/*.fixture.md"
    - "fixtures/**/*.md"

todos:
  # AI specs for normal and read-only plan runs. The {{{body}}} variable is the
  # selected TODO content injected by Gavel.
  run:
    model: claude-sonnet-4-5
    prompt:
      user: |
        Implement the selected work and satisfy its definition of done:
        {{{body}}}

  plan:
    prompt:
      user: |
        Produce a read-only implementation plan for:
        {{{body}}}

  timeout: 45m

  # Overrides the built-in todo lifecycle (todos/lifecycle/todos.yaml): the
  # ordered steps, each a captain prompt reference, a CEL `when` predicate
  # (subject/runs/last) deciding when the step applies, and ordered `outcomes`
  # deciding which status a finished run lands the todo in.
  #
  # `file:` and this inline form are mutually exclusive. A step named like a
  # built-in step (plan/verify/run/triage) replaces it wholesale; a new name is
  # appended. A `verify` step must survive the merge.
  lifecycle:
    steps:
      # Add a security-review pass after `run` lands, before verification.
      - name: security-review
        prompt: "file:.gavel/prompts/security-review.prompt"
        envelope: result
        when: "subject.status in ['pending'] && has(last.run) && last.run.state == 'succeeded'"
        outcomes:
          - { status: ask, when: "envelope.endStatus == 'ask'" }
          - { status: failed, when: "run.state != 'succeeded' || envelope.endStatus == 'failed'" }
          - { status: pending, when: "true" }

status:
  # Per-file summary used by `gavel status --ai`; receives {{details}}.
  summary:
    prompt:
      user: |
        Summarize the user-visible intent of these changes:
        {{details}}

test:
  # Per-test summary used by `gavel test outline --ai-summary`.
  outlineSummary:
    model: claude-haiku-4-5
    prompt:
      user: Summarize tests {{ids}} from {{file}} using {{source}}.

pr:
  # AI-generated pull-request title, body, and branch name.
  content:
    model: claude-sonnet-4-5
    prompt:
      user: |
        Create pull-request content for these commits:
        {{#each commits}}
        - {{message}} ({{files}})
        {{/each}}
  base: origin/main
  draft: true

checks:
  # The post-completion check loop inside `gavel todos run`. Once an agent
  # reports it is done, gavel runs the configured test/lint suite below; if it
  # fails, gavel feeds a compact failure summary back to the agent and re-runs,
  # looping until the checks pass or todos.run.workflow.verify.maxIterations is
  # reached. Opt-in: the loop runs only when enabled here. A TODO's frontmatter
  # `checks:` block overrides these project defaults.
  enabled: true
  # CEL predicate evaluated after each iteration; true runs the agent again.
  retry: results.failed > 0 || results.warned > 0 || !results.checklist.all(i, i.passed)
  # Omit `test` to skip tests; omit `lint` to skip linting. When the loop is
  # enabled with neither set, it defaults to running both against changed files.
  test:
    changed: true        # only packages affected by the agent's changes
    timeout: 5m          # global wall-clock deadline for the test run
    # paths: ["./pkg/..."]  # restrict to specific package paths
  lint:
    changed: true        # only report new violations vs the base ref
    timeout: 5m          # per-linter deadline
    # linters: ["golangci-lint"]  # restrict to specific linters

ssh:
  # Overrides the command executed by the SSH post-receive hook / push backend.
  # If omitted, the fallback is `gavel test --lint`.
  cmd: gavel test --lint --verify --fixtures

pre:
  # Top-level pre hooks run before the main test/lint pipeline.
  # These are appended across layers and run in declaration order.
  - name: generate
    run: go generate ./...

  - name: deps
    run: make tidy

post:
  # Top-level post hooks run after the main pipeline.
  # These are non-blocking cleanup / reporting hooks.
  - name: summarize
    run: gavel summary --input gavel-results.json --output gavel-summary.md

  - name: cleanup
    run: rm -rf .tmp/gavel

secrets:
  # Set true to disable betterleaks / gitleaks orchestration entirely.
  # This is sticky across layers: once true anywhere, it stays true.
  disabled: false

  # Additional .betterleaks.toml / .gitleaks.toml files to merge in.
  # Relative paths resolve from the directory containing this `.gavel.yaml`.
  configs:
    - ".betterleaks.toml"
    - "security/custom-gitleaks.toml"

procfile:
  # Global defaults for `gavel proc`. Per-process settings (command, default,
  # autoRestart, cpu, mem, profiles, env, maxRestarts) live in the Procfile
  # itself — this section only holds defaults and the active profile.

  # Default active profile. A Procfile entry with `profiles` auto-starts only
  # when one of them is active; `gavel proc --profile <name>` overrides this.
  profile: dev

  # Default restart policy for every process. A bool (true=on-failure,
  # false=no) or an enum: no (never), on-failure (non-zero exit), always.
  autoRestart: on-failure

  # Cap automatic restarts per process (0 = unlimited).
  maxRestarts: 5

  # Environment injected into every process, on top of the parent environment
  # and any sibling .env file. Env maps merge key-by-key across layers.
  env:
    RAILS_ENV: development

  # Default resource limits per process. Both are off unless set. A process
  # whose process group exceeds a limit is killed (and restarted per policy).
  #   mem  resident-memory cap (e.g. "512Mi", "2g")
  #   cpu  sustained CPU percentage (100 = one full core)
  mem: 2Gi
  cpu: 400

# Per-process settings live in the Procfile (YAML). A string entry is the
# command (started by default, runs in every profile); an object entry adds
# default/autoRestart/cpu/mem/profiles/env/maxRestarts:
#
#   web: npm start
#   worker:
#     command: rake jobs:work
#     default: false            # registered but not auto-started
#     autoRestart: on-failure   # bool or no|on-failure|always
#     cpu: 100
#     mem: 512Mi
#     maxRestarts: 10
#     env: { WORKER_CONCURRENCY: "4" }
#   mailcatcher:
#     command: mailcatcher
#     profiles: [dev]           # only runs when the dev profile is active
