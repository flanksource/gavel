---
name: editor-comments
description: Work a `gavel edit` comment thread in its project, replying to and resolving it through gavel comments as this session's agent.
model: claude
mode: agent
budget:
  maxTurns: 60
  timeout: 45m
setup:
  cwd: "{{dir}}"
prompt:
  system: >-
    You are the agent session `gavel edit` started for comment threads on files in
    {{dir}}. Each thread arrives as a message, already acknowledged for you: never
    acknowledge it again. Work one thread at a time: implement the scoped change it
    asks for, verify it, reply with what you changed and how you verified it using
    reply_to_thread, then resolve it with resolve_thread. Use these tools for the
    threads instead of calling gavel comments yourself; list_threads reads the open
    threads on the file.
permissions:
  mode: acceptEdits
  tools:
    Read: allow
    Glob: allow
    Grep: allow
    Edit: allow
    Write: allow
    Bash: allow
tools:
  list_threads:
    description: List the comment threads on this session's file, with their replies and current versions.
    input: {}
    readonly: true
    exec: |
      set -euo pipefail
      export GAVEL_COMMENT_ACTOR={{shq actor}}
      {{shq gavelExecutable}} comments list --scope {{shq scope}} --target {{shq target}} --json
  reply_to_thread:
    description: Reply to a comment thread as this session's agent. Say what you changed and how you verified it.
    input: {id: "string, the thread's comment id", body: "string, the reply in Markdown"}
    permission: allow
    exec: |
      set -euo pipefail
      export GAVEL_COMMENT_ACTOR={{shq actor}}
      input=$(cat)
      id=$(jq -r .id <<<"$input")
      version=$({{shq gavelExecutable}} comments get "$id" --json | jq -r .version)
      {{shq gavelExecutable}} comments reply "$id" --expectedVersion "$version" --bodyMarkdown "$(jq -r .body <<<"$input")" --json
  resolve_thread:
    description: Resolve a comment thread once its change is made, verified and replied to. A human then reviews it.
    input: {id: "string, the thread's comment id", summary: "string, one line on what was done"}
    permission: allow
    exec: |
      set -euo pipefail
      export GAVEL_COMMENT_ACTOR={{shq actor}}
      input=$(cat)
      id=$(jq -r .id <<<"$input")
      version=$({{shq gavelExecutable}} comments get "$id" --json | jq -r .version)
      {{shq gavelExecutable}} comments resolve "$id" --expectedVersion "$version" --summary "$(jq -r .summary <<<"$input")" --json
---
{{{message}}}
